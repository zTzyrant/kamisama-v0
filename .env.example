# .env.example — BOLEH dicopy jadi .env lalu isi value real.
# .env ASLI jangan pernah di-commit (masuk .gitignore).
# Saat CI/CD: .env di-generate runner dari secrets.ENV_FILE (D6), lalu
# PRODUCTION_URL/BASE_URL di-override dari vars.PRODUCTION_URL.
#
# Isi secrets.ENV_FILE yang valid untuk app ini:
#   VITE_API_URL=https://elysia.kamisama-v0.my.id/api
#   PORT=3000
#   NODE_ENV=production
#   PRODUCTION_URL=https://v0.kamisama-v0.my.id

# Build-time embed (Vite) — backend API publik. Ganti = rebuild.
VITE_API_URL=https://elysia.kamisama-v0.my.id/api

# Runtime — port dalam container, SELALU 3000 (D7). Jangan samakan dengan LIVE/COPY/FRONT.
PORT=3000
NODE_ENV=production

# Domain publik — single source of truth = vars.PRODUCTION_URL di CI.
PRODUCTION_URL=https://v0.kamisama-v0.my.id
